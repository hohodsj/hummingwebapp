# Environment Configuration Template
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration
# Local MongoDB: mongodb://localhost:27017/hummingweb
# MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
DB_URL=mongodb://localhost:27017/hummingweb

# Google OAuth 2.0 Configuration
# Get credentials from https://console.cloud.google.com/
GOOGLE_DRIVE_CLIENT_ID=your_client_id_here
GOOGLE_DRIVE_CLIENT_SECRET=your_client_secret_here
GOOGLE_DRIVE_REDIRECT_URL=https://localhost:3000/google/callback
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_here

# Session Secret
# Generate a secure random string for production
SECRET=change_me_to_secure_random_string

# Cloudinary (Optional - for image hosting)
# Sign up at https://cloudinary.com/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_cloudinary_key
CLOUDINARY_SECRET=your_cloudinary_secret
